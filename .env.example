# 足韵 yuwen-spa 环境变量示例
# 复制为 .env 并按需修改；安装脚本在缺失时会自动生成 JWT_SECRET。
#
# .env 已在 .gitignore 中，不会提交到仓库。

# JWT 签名密钥（必填，≥32 字节随机 hex）。更换后所有登录 token 失效。
JWT_SECRET=

# 服务端口（默认 8080；被占用时自动向后探测）
# PORT=8080

# 日志级别：fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# 支付回调 HMAC（可选，与网关配置一致时启用验签）
# PAYMENT_CALLBACK_SECRET=
